@page "/home"
@using SchoolProperty.Web.Models
@using SchoolPropertyEvidence.Models
@inject NavigationManager Nav
@inject IHttpClientFactory HttpFactory

<PageTitle>Home</PageTitle>

<h1>School Property Database</h1>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Název</th>
            <th>Třídní</th>
            <th>Počítače</th>
            <th>Nábitek</th>
            <th>Elektronika</th>
            <th>Učební pomůcky</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Items)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.RoomName</td>
                <td>@(string.IsNullOrEmpty(item.ResponsibleFirstName) ? string.Empty : $"{item.ResponsibleFirstName} {item.ResponsibleLastName}")</td>
                <td>@item.Computers</td>
                <td>@item.Furniture</td>
                <td>@item.Electronics</td>
                <td>@item.LearningEquipment</td>
            </tr>
        }
    </tbody>
</table>

<div class="btn-group mt-3">
    <button class="btn btn-primary" @onclick="NavigateAdd">Add</button>
    <button class="btn btn-danger" @onclick="NavigateDelete">Delete</button>
    <button class="btn btn-warning text-dark" @onclick="NavigateEdit">Edit</button>
</div>

@code {
    private List<RoomWithCountsDto> Items = new();

    private async Task InitializeItemsAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient("ServerAPI");
            var result = await http.GetFromJsonAsync<List<RoomWithCountsDto>>("api/rooms/withcounts");
            Items = result ?? new();
        }
        catch
        {
            Items = new();
            // případně přidat logování nebo zobrazení chyby
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await InitializeItemsAsync();
    }

    private void NavigateAdd() => Nav.NavigateTo("/add");
    private void NavigateDelete() => Nav.NavigateTo("/delete");
    private void NavigateEdit() => Nav.NavigateTo("/edit");
}