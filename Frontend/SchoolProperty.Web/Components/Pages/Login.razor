@page "/login"
@layout EmptyLayout
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="form-page">
    <div class="form-card">
        <h3 class="form-title">Login</h3>

        <div class="form-group">
            <label>Email</label>
            <input @bind="email" @bind:event="oninput" placeholder="Enter your email" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input @bind="password" @bind:event="oninput" type="password" placeholder="Enter your password" />
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="form-error">@message</p>
        }

        <button class="form-btn" @onclick="HandleLogin">Login</button>

        <p class="form-link"><a href="/register">Don't have an account? Register</a></p>
    </div>
</div>

<style>
    .form-page {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #f5f5f5;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        padding: 40px 36px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
    }

    .form-title {
        margin: 0 0 28px 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: #222;
        text-align: center;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 18px;
    }

        .form-group label {
            font-size: 0.875rem;
            font-weight: 500;
            color: #444;
            margin-bottom: 6px;
        }

        .form-group input {
            padding: 10px 12px;
            border: 1px solid #d0d0d0;
            border-radius: 6px;
            font-size: 0.95rem;
            color: #333;
            outline: none;
            transition: border-color 0.2s;
        }

            .form-group input:focus {
                border-color: #7c3aed;
            }

    .form-btn {
        width: 100%;
        padding: 11px;
        margin-top: 8px;
        background-color: #7c3aed;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .form-btn:hover {
            background-color: #6d28d9;
        }

    .form-error {
        color: #dc2626;
        font-size: 0.875rem;
        margin: 0 0 12px 0;
    }

    .form-link {
        text-align: center;
        margin-top: 20px;
        font-size: 0.875rem;
        color: #666;
    }

        .form-link a {
            color: #7c3aed;
            text-decoration: none;
        }

            .form-link a:hover {
                text-decoration: underline;
            }
</style>

@code {
    private string email = "";
    private string password = "";
    private string message = "";

    private async Task HandleLogin()
    {
        var http = HttpFactory.CreateClient("ServerAPI");

        var loginRequest = new { Email = email, Password = password };
        var json = System.Text.Json.JsonSerializer.Serialize(loginRequest);
        var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

        var response = await http.PostAsync("api/auth/login", content);

        if (response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadAsStringAsync();
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            var token = doc.RootElement.GetProperty("token").GetString();
            await JS.InvokeVoidAsync("localStorage.setItem", "authToken", token);
            message = "";
            Nav.NavigateTo("/home");
        }
        else
        {
            message = "Invalid email or password.";
        }
    }
}
