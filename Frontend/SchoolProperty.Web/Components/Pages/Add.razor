@page "/add"
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

@using System.Net.Http.Headers
@using System.Net.Http.Json

<PageTitle>Add Record</PageTitle>

<h1>Přidat záznam</h1>

<div class="mb-3">
    <label class="form-label">Typ</label>
    <select class="form-select" @bind="AddType">
        <option value="Item">Položka (Item)</option>
        <option value="Room">Místnost (Room)</option>
    </select>
</div>

@if (AddType == "Item")
{
    <EditForm Model="itemModel" OnValidSubmit="Save">
        <div class="mb-3">
            <label class="form-label">Item name</label>
            <InputText class="form-control" @bind-Value="itemModel.ItemName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputText class="form-control" @bind-Value="itemModel.Description" />
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <select class="form-select" @bind="itemModel.CategoryId">
                <option value="">-- vyber --</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Room</label>
            <select class="form-select" @bind="itemModel.RoomId">
                <option value="">-- vyber --</option>
                @foreach (var r in rooms)
                {
                    <option value="@r.Id">@r.RoomName</option>
                }
            </select>
        </div>
        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="itemModel.IsActive" />
            <label class="form-check-label">In use (IsActive)</label>
        </div>
        <button class="btn btn-success me-2" type="submit">Save item</button>
        <button class="btn btn-secondary" type="button" @onclick="Cancel">Cancel</button>
    </EditForm>
}
else
{
    <EditForm Model="roomModel" OnValidSubmit="Save">
        <div class="mb-3">
            <label class="form-label">Room name</label>
            <InputText class="form-control" @bind-Value="roomModel.RoomName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Responsible person</label>
            <select class="form-select" @bind="roomModel.ResponsiblePersonId">
                <option value="">-- vyber --</option>
                @foreach (var p in people)
                {
                    <option value="@p.Id">@p.FirstName @p.LastName</option>
                }
            </select>
        </div>
        <button class="btn btn-success me-2" type="submit">Save room</button>
        <button class="btn btn-secondary" type="button" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-info mt-3">@Message</div>
}

@code {
    private string AddType { get; set; } = "Item";

    private ItemCreateDto itemModel = new()
    {
        ItemName = "",
        Description = "",
        CategoryId = null,
        RoomId = null,
        IsActive = true
    };

    private RoomCreateDto roomModel = new()
    {
        RoomName = "",
        ResponsiblePersonId = null
    };

    // Each list uses a DTO that matches the actual API response shape
    private List<CategoryLookupDto> categories = new();
    private List<RoomLookupDto> rooms = new();
    private List<PersonLookupDto> people = new();

    private string Message = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
    }

    private async Task LoadLookups()
    {
        var http = await CreateAuthorizedClient();

        try
        {
            // api/categories returns CategoryModel: { id, categoryName, description }
            categories = await http.GetFromJsonAsync<List<CategoryLookupDto>>("api/categories") ?? new();
        }
        catch { categories = new(); }

        try
        {
            // api/rooms returns RoomModel: { id, roomName, ... }
            rooms = await http.GetFromJsonAsync<List<RoomLookupDto>>("api/rooms") ?? new();
        }
        catch { rooms = new(); }

        try
        {
            // api/people returns PeopleModel: { id, firstName, lastName }
            people = await http.GetFromJsonAsync<List<PersonLookupDto>>("api/people/teachers") ?? new();
        }
        catch { people = new(); }
    }

    private async Task Save()
    {
        var http = await CreateAuthorizedClient();

        if (AddType == "Item")
        {
            if (
                string.IsNullOrWhiteSpace(itemModel.ItemName) ||
                itemModel.CategoryId == null ||
                itemModel.RoomId == null)
            {
                Message = "Vyplňte prosím povinná pole pro položku (item name, category, room).";
                return;
            }

            var resp = await http.PostAsJsonAsync("api/items", itemModel);
            if (resp.IsSuccessStatusCode)
            {
                Message = "Položka byla úspěšně přidána.";
                Nav.NavigateTo("/home");
            }
            else
            {
                var detail = await resp.Content.ReadAsStringAsync();
                Message = $"Chyba při vytváření položky: {resp.StatusCode} — {detail}";
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(roomModel.RoomName) || roomModel.ResponsiblePersonId == null)
            {
                Message = "Vyplňte prosím povinná pole pro místnost (room name, responsible person).";
                return;
            }

            var resp = await http.PostAsJsonAsync("api/rooms", roomModel);
            if (resp.IsSuccessStatusCode)
            {
                Message = "Místnost byla úspěšně přidána.";
                Nav.NavigateTo("/home");
            }
            else
            {
                Message = $"Chyba při vytváření místnosti: {resp.StatusCode}";
            }
        }
    }

    private void Cancel() => Nav.NavigateTo("/home");

    private async Task<HttpClient> CreateAuthorizedClient()
    {
        var client = HttpFactory.CreateClient("ServerAPI");
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrEmpty(token))
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    // ── DTOs matching actual API response shapes ──────────────────────────────

    private class ItemCreateDto
    {
        public string InventoryNumber { get; set; } = "";
        public string ItemName { get; set; } = "";
        public string? Description { get; set; }
        public int? CategoryId { get; set; }
        public int? RoomId { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private class RoomCreateDto
    {
        public string RoomName { get; set; } = "";
        public int? ResponsiblePersonId { get; set; }
    }

    // Matches CategoryModel: id + categoryName
    private class CategoryLookupDto
    {
        public int Id { get; set; }
        public string CategoryName { get; set; } = "";
    }

    // Matches RoomModel: id + roomName
    private class RoomLookupDto
    {
        public int Id { get; set; }
        public string RoomName { get; set; } = "";
    }

    // Matches PeopleModel: id + firstName + lastName
    private class PersonLookupDto
    {
        public int Id { get; set; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
    }
}
