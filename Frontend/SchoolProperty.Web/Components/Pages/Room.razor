@page "/room"
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

@using System.Net.Http.Headers
@using System.Net.Http.Json

<PageTitle>Room Detail</PageTitle>

<div class="room-page">
    <div class="room-header">
        <h1 class="room-title">Detail místnosti</h1>
        <button class="back-btn" @onclick="GoHome">← Zpět</button>
    </div>

    <div class="mb-3" style="max-width: 320px;">
        <label class="form-label fw-semibold">Místnost</label>
        <select class="form-select" @bind="SelectedRoomId" @bind:after="LoadRoomItems">
            <option value="0">-- vyber místnost --</option>
            @foreach (var r in rooms)
            {
                <option value="@r.Id">@r.Id — @r.RoomName</option>
            }
        </select>
    </div>

    @if (loadError)
    {
        <div class="alert alert-danger">Nepodařilo se načíst položky.</div>
    }
    else if (SelectedRoomId > 0 && !roomItems.Any())
    {
        <p class="text-muted">Tato místnost neobsahuje žádné položky.</p>
    }
    else if (roomItems.Any())
    {
        <div class="table-wrapper">
            <table class="item-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Název</th>
                        <th>Popis</th>
                        <th>Kategorie</th>
                        <th>Aktivní</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in roomItems)
                    {
                        <tr class="clickable-row" @onclick="() => NavigateToEdit(item.Id)">
                            <td>@item.Id</td>
                            <td>@item.ItemName</td>
                            <td>@item.Description</td>
                            <td>@item.CategoryName</td>
                            <td>@(item.IsActive ? "✓" : "✗")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .room-page {
        padding: 32px;
        min-height: 100%;
        box-sizing: border-box;
    }

    .room-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .room-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: #222;
    }

    .back-btn {
        background: transparent;
        border: 1px solid #7c3aed;
        color: #7c3aed;
        border-radius: 6px;
        padding: 6px 16px;
        font-size: 0.9rem;
        cursor: pointer;
    }

        .back-btn:hover {
            background: #f3eeff;
        }

    .table-wrapper {
        overflow-x: auto;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        background: #fff;
        margin-top: 16px;
    }

    .item-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.925rem;
        color: #333;
    }

        .item-table thead tr {
            background-color: #7c3aed;
            color: #fff;
        }

        .item-table th {
            padding: 11px 14px;
            text-align: left;
            font-weight: 500;
            white-space: nowrap;
        }

        .item-table td {
            padding: 10px 14px;
            border-top: 1px solid #e0e0e0;
            color: #444;
        }

        .item-table tbody tr:nth-child(even) {
            background-color: #fafafa;
        }

        .item-table tbody tr:hover {
            background-color: #f3eeff;
        }

    .clickable-row {
        cursor: pointer;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public int SelectedRoomId { get; set; } = 0;

    private List<RoomLookupDto> rooms = new();
    private List<ItemDto> roomItems = new();
    private bool loadError = false;

    protected override async Task OnInitializedAsync()
    {
        var http = await CreateAuthorizedClient();

        try { rooms = await http.GetFromJsonAsync<List<RoomLookupDto>>("api/rooms") ?? new(); }
        catch { }

        if (SelectedRoomId > 0)
            await LoadRoomItems();
    }

    private async Task LoadRoomItems()
    {
        if (SelectedRoomId == 0) { roomItems = new(); return; }

        loadError = false;
        try
        {
            var http = await CreateAuthorizedClient();
            var all = await http.GetFromJsonAsync<List<ItemDto>>("api/items") ?? new();
            roomItems = all.Where(i => i.RoomId == SelectedRoomId).ToList();
        }
        catch { loadError = true; roomItems = new(); }
    }

    private void GoHome() => Nav.NavigateTo("/home");

    private void NavigateToEdit(int itemId) => Nav.NavigateTo($"/edit?itemId={itemId}");

    private async Task<HttpClient> CreateAuthorizedClient()
    {
        var client = HttpFactory.CreateClient("ServerAPI");
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrEmpty(token))
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    private class RoomLookupDto
    {
        public int Id { get; set; }
        public string RoomName { get; set; } = "";
    }

    private class ItemDto
    {
        public int Id { get; set; }
        public string ItemName { get; set; } = "";
        public string? Description { get; set; }
        public int CategoryId { get; set; }
        public string? CategoryName { get; set; }
        public int RoomId { get; set; }
        public bool IsActive { get; set; }
    }
}
